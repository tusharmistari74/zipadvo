# ==============================================================================
# LegalHubMumbai - Staging Environment Configuration Template
# Target: https://staging.legalhubmumbai.com
# Firebase Project: legalhubmumbai-staging
# ==============================================================================

# Application Environment
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_URL=https://staging.legalhubmumbai.com
NODE_ENV=production

# Staging Firebase Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyStagingClientMockApiKey123456789
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=legalhubmumbai-staging.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=legalhubmumbai-staging
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=legalhubmumbai-staging.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=200000000001
NEXT_PUBLIC_FIREBASE_APP_ID=1:200000000001:web:stagingabcdef012345
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-STAGING001

# Razorpay Sandbox Test Mode (Zero real financial charges)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_staging_sandbox_key_2026
RAZORPAY_KEY_SECRET=rzp_test_staging_sandbox_secret_2026
RAZORPAY_WEBHOOK_SECRET=whsec_staging_test_webhook_2026

# Staging Firebase Admin SDK (Server-Side Only - Injected via GitHub Secrets)
FIREBASE_ADMIN_PROJECT_ID=legalhubmumbai-staging
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-staging@legalhubmumbai-staging.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQCstagingmockkey...\n-----END PRIVATE KEY-----\n"

# Notification Test Channels (In-app + mock sandbox drivers)
NOTIFICATION_DRIVER=in_app
SMS_TEST_MODE=true
EMAIL_TEST_MODE=true

# Security & CORS
ALLOWED_ORIGINS=https://staging.legalhubmumbai.com
CSRF_SECRET=csrf_staging_session_secret_2026_mock
