# ==============================================================================
# LegalHubMumbai - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env.local FOR LOCAL DEVELOPMENT
# DO NOT COMMIT REAL CREDENTIALS, KEYS, OR SECRETS TO VERSION CONTROL!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE / APP ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE FIREBASE CONFIGURATION (Publicly accessible in browser)
# ------------------------------------------------------------------------------
# These identify your Firebase project to the Firebase Web SDK.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyPlaceholderClientApiKey123456789
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=legalhubmumbai-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=legalhubmumbai-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=legalhubmumbai-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=100000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:100000000000:web:abcdef1234567890
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Firebase Emulator Suite toggle
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ------------------------------------------------------------------------------
# 3. SERVER-ONLY FIREBASE ADMIN SDK CREDENTIALS (NEVER EXPOSE TO BROWSER)
# ------------------------------------------------------------------------------
# Provide either individual fields OR base64-encoded Service Account JSON.
FIREBASE_ADMIN_PROJECT_ID=legalhubmumbai-dev
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@legalhubmumbai-dev.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay) - PRODUCTION KEYS
# ------------------------------------------------------------------------------
# Public Key (Safe for client checkout initialization)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Secret Key (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key_server_only
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 5. STORAGE & DOCUMENT SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
STORAGE_PRIVATE_BUCKET=legalhubmumbai-private-documents.appspot.com
SIGNED_URL_EXPIRY_SECONDS=900

# ------------------------------------------------------------------------------
# 6. PLATFORM PRICING CONFIGURATION (Currency in INR)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CONSULTATION_UNLOCK_FEE_INR=299
NEXT_PUBLIC_PLATFORM_COMMISSION_PERCENTAGE=10

# ------------------------------------------------------------------------------
# 7. GOOGLE PLATFORM & MAPS INTEGRATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=placeholder_recaptcha_site_key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyArMH1TV9RKOMFm-69ckReSUvKphw2sUwQ
