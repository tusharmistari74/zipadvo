rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Authentication & Role Helper Functions
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || request.auth.token.role == 'super_admin');
    }

    function isLawyer() {
      return isAuthenticated() && request.auth.token.role == 'lawyer';
    }

    // =========================================================================
    // 1. Users Collection (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role != 'admin';
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. Lawyers Collection (/lawyers/{lawyerId})
    // =========================================================================
    match /lawyers/{lawyerId} {
      // Public can read verified lawyer profiles; owners and admins can read any status
      allow read: if (resource.data.kycStatus == 'verified') || isOwner(lawyerId) || isAdmin();
      allow create: if isOwner(lawyerId);
      // KYC status and featured status can only be modified by Admins
      allow update: if (isOwner(lawyerId) && request.resource.data.kycStatus == resource.data.kycStatus && request.resource.data.featured == resource.data.featured) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 3. Lawyer KYC Private Submissions (/lawyer_kyc/{lawyerId})
    // =========================================================================
    match /lawyer_kyc/{lawyerId} {
      allow read: if isOwner(lawyerId) || isAdmin();
      allow create: if isOwner(lawyerId);
      allow update: if isOwner(lawyerId) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 4. Bookings Collection (/bookings/{bookingId})
    // =========================================================================
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && 
        (resource.data.clientUid == request.auth.uid || 
         resource.data.lawyerUid == request.auth.uid || 
         isAdmin());
      allow create: if isAuthenticated() && request.resource.data.clientUid == request.auth.uid;
      allow update: if isAuthenticated() && 
        (resource.data.clientUid == request.auth.uid || 
         resource.data.lawyerUid == request.auth.uid || 
         isAdmin());
      allow delete: if false; // Soft deletes / immutable record
    }

    // =========================================================================
    // 5. Payments Collection (/payments/{paymentId})
    // STRICT RULE: All payment mutations must go through trusted Cloud Functions
    // =========================================================================
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && 
        (resource.data.clientUid == request.auth.uid || 
         resource.data.lawyerUid == request.auth.uid || 
         isAdmin());
      allow write: if false; // Server-only Admin SDK writes
    }

    // =========================================================================
    // 6. Documents Metadata Collection (/documents/{documentId})
    // =========================================================================
    match /documents/{documentId} {
      allow read: if isAuthenticated() && 
        (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && 
        (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // 7. Reviews Collection (/reviews/{reviewId})
    // =========================================================================
    match /reviews/{reviewId} {
      allow read: if (resource.data.status == 'published') || 
        (isAuthenticated() && resource.data.clientUid == request.auth.uid) || 
        isAdmin();
      allow create: if isAuthenticated() && request.resource.data.clientUid == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.clientUid == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 8. Disputes Collection (/disputes/{disputeId})
    // =========================================================================
    match /disputes/{disputeId} {
      allow read: if isAuthenticated() && 
        (resource.data.raisedByUid == request.auth.uid || 
         resource.data.againstUid == request.auth.uid || 
         isAdmin());
      allow create: if isAuthenticated() && request.resource.data.raisedByUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // =========================================================================
    // 9. Notifications Collection (/notifications/{notificationId})
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      allow update: if isAuthenticated() && 
        resource.data.recipientUid == request.auth.uid && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if false; // Server-only
    }

    // =========================================================================
    // 10. Platform Settings (/platform_settings/{settingId})
    // =========================================================================
    match /platform_settings/{settingId} {
      allow read: if true; // Public pricing, support contact, and regional scope
      allow write: if isAdmin();
    }

    // =========================================================================
    // 11. Audit Logs (/audit_logs/{logId})
    // =========================================================================
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Server-only Admin SDK writes
    }
  }
}
